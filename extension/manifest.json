{
  "manifest_version": 3,
  "name": "Chat Saver – Export AI Chats",
  "short_name": "Chat Saver",
  "version": "2.0.0",
  "description": "Save whole AI chats (ChatGPT, Claude, Gemini, GLM, DeepSeek, Copilot, Perplexity, Grok, Manus and more) as PDF, TXT and Markdown. Paste a link or click once — it scrolls the full chat for you.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save this chat",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "19": "icons/toolbar-19.png",
      "32": "icons/toolbar-32.png",
      "38": "icons/toolbar-38.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "downloads", "notifications", "contextMenus", "debugger"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "Open Chat Saver"
    }
  },
  "browser_specific_settings": {
    "gecko": { "id": "chatsaver@bakulesh1codes108", "strict_min_version": "121.0" }
  }
}
